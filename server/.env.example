# Copia este archivo a .env y ajusta los valores
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/predicciones

# Clave para la API de administración (back-office y moderación)
ADMIN_API_KEY=cambia-esta-clave-admin
# Secreto para firmar los tokens de sesión de jugadores
SESSION_SECRET=cambia-este-secreto-de-sesion

# IA (Claude) para generar preguntas y proponer resoluciones. Sin clave, la IA queda desactivada.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Fuentes opcionales con clave
NEWSAPI_KEY=

# Reglas del mercado
TAKER_FEE_BPS=200
CHALLENGE_WINDOW_MINUTES=120
MM_ENABLED=true
MM_SPREAD_CENTS=4
MM_LEVEL_SIZE_SHARES=200
MM_MAX_EXPOSURE_USD=5000

# Tareas programadas (minutos). 0 desactiva la tarea.
INGEST_EVERY_MIN=30
GENERATE_EVERY_MIN=120
MM_REFRESH_EVERY_SEC=30
