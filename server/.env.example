# Copia este archivo a .env y ajusta los valores
PORT=8080
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/predicciones

# Clave para la API de administración (back-office y moderación)
ADMIN_API_KEY=cambia-esta-clave-admin
# Secreto para firmar los tokens de sesión de jugadores
SESSION_SECRET=cambia-este-secreto-de-sesion

# IA (Claude) para generar preguntas y proponer resoluciones. Sin clave, la IA queda desactivada.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Fuentes opcionales con clave
NEWSAPI_KEY=

# Reglas del mercado
TAKER_FEE_BPS=200
CHALLENGE_WINDOW_MINUTES=120
MM_ENABLED=true
MM_SPREAD_CENTS=4
MM_LEVEL_SIZE_SHARES=200
MM_MAX_EXPOSURE_USD=5000
# Market maker v2 (docs/MARKET-MAKER.md). MM_STRATEGY=v1 vuelve a la versión anterior; MM_SPREAD_CENTS y
# MM_MAX_EXPOSURE_USD solo aplican a v1.
MM_STRATEGY=v2
MM_LEVELS=3
MM_B_SHARES=1500
MM_GAMMA=0.5
MM_KAPPA=12
MM_SIGMA_FLOOR=0.25
MM_HOLD_DAYS=1
MM_MIN_HALF_SPREAD_CENTS=1
MM_TAU_REF_DAYS=7
MM_MIN_LIQUIDITY=0.15
MM_MAX_LOSS_USD=2000
MM_MAX_TOTAL_LOSS_USD=50000
MM_W_PREV=0.6
MM_W_EXTERNAL=0.5
MM_EXTERNAL_MAX_AGE_HOURS=6
# Protección contra apostadores informados (docs/MARKET-MAKER.md)
TOX_ENABLED=true
TOX_MARKOUT_MIN=60
TOX_MIN_TRADES=10
TOX_CONFIDENCE_Z=2
TOX_START_CENTS=0.5
TOX_FULL_CENTS=3
TOX_MAX_SURCHARGE_BPS=300
TOX_FLOW_WINDOW_MIN=360
TOX_IMBALANCE_SPREAD=0.12
TOX_IMBALANCE_MIN_USD=150
TOX_BREAKER_CENTS=12
TOX_BREAKER_WINDOW_MIN=10
TOX_PAUSE_MIN=5
TOX_SHOCK_MIN=30
TOX_SHOCK_SPREAD_MULT=2
TOX_SHOCK_SIZE_FACTOR=0.5

# Tareas programadas (minutos). 0 desactiva la tarea.
INGEST_EVERY_MIN=30
GENERATE_EVERY_MIN=120
MM_REFRESH_EVERY_SEC=30

# Catálogo: mínimo de mercados abiertos por categoría que la IA intenta mantener
MIN_OPEN_PER_CATEGORY=25
MAX_NEW_PER_CATEGORY_RUN=10
REFILL_EVERY_MIN=360
# true = publicar sin moderación los borradores de la IA que pasan la validación
AUTO_APPROVE_AI_DRAFTS=false

# Integridad
MAX_STAKE_PER_MARKET_USD=1000
INTEGRITY_MIN_VOLUME_USD=200
INTEGRITY_ALERT_MIN_USD=100
INTEGRITY_LATE_WINDOW_MIN=120

# Oráculo y resolución con fianzas (docs/ORACULO.md)
ORACLE_NAME=Predicciones
# Clave Ed25519 en PEM con los saltos de línea como \n (si se deja vacía se genera una y se guarda en la base)
ORACLE_PRIVATE_KEY=
ORACLE_CACHE_SECONDS=30
RESOLUTION_BOND_USD=10
HOUSE_BOND_USD=100
BOND_REWARD_SHARE=0.5
PLAYER_PROPOSE_AFTER_HOURS=2

# P2P: market makers externos y liquidación entre casinos (docs/P2P.md)
MAKER_REBATE_BPS=50
MM_API_MAX_BATCH=50
HOUSE_BACKSTOP_CENTS=2
HOUSE_BACKSTOP_MIN_SHARES=200
HOUSE_BACKSTOP_SPREAD_MULT=2

# Tesorería (docs/TESORERIA.md)
SETTLEMENT_EVERY_HOURS=24
SETTLEMENT_PAYMENT_TERM_HOURS=48
TREASURY_AUTO_COLLECT_GUARANTEE=false
TREASURY_JOB_EVERY_MIN=30

# Modelo mixto (docs/TESORERIA.md): sello en Bitcoin y vía USDC opcional
ANCHOR_ENABLED=true
ANCHOR_EVERY_HOURS=24
# Pruebas sin dinero real: USDC_CHAIN=simulado (sin cadena, transferencias simuladas desde el back-office)
# o una red de prueba: USDC_CHAIN=base-sepolia, USDC_RPC_URL=https://sepolia.base.org (USDC gratis en faucet.circle.com)
USDC_RPC_URL=
USDC_CHAIN=polygon
USDC_VAULT_ADDRESS=
USDC_START_BLOCK=
USDC_CONFIRMATIONS=20
