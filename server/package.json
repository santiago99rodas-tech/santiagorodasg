{
  "name": "predicciones-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de mercados de predicción integrable por API en casinos online",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "mock-casino": "tsx mock-casino/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "simulate": "tsx mock-casino/simulate.ts",
    "sim": "tsx src/sim/run.ts",
    "demo:build": "tsx ../demo/build.mts",
    "gen:secrets": "tsx scripts/gen-secrets.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
