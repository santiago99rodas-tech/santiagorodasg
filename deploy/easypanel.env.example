# Variables del servicio "api" en Easypanel (Environment). Copia, completa lo marcado con <> y pega.
# Las claves se generan con:  cd server && npm run gen:secrets

# ---------- Obligatorias ----------
DATABASE_URL=<Internal Connection URL del servicio Postgres "db">
PUBLIC_URL=https://predicciones.bo-sio.com
ADMIN_API_KEY=<de npm run gen:secrets, 24 caracteres o más>
SESSION_SECRET=<de npm run gen:secrets, 24 caracteres o más>
# Clave del oráculo: 64 caracteres de npm run gen:secrets (también acepta el PEM completo)
ORACLE_PRIVATE_KEY=<64 caracteres de npm run gen:secrets>

# ---------- Opcionales ----------
# IA para generar y resolver preguntas (sin clave, todo lo demás funciona)
ANTHROPIC_API_KEY=
NEWSAPI_KEY=
ORACLE_NAME=Predicciones

# Comisión de los jugadores (200 = 2%)
TAKER_FEE_BPS=200
CHALLENGE_WINDOW_MINUTES=120

# Market maker de la casa (docs/MARKET-MAKER.md). MM_STRATEGY=v1 vuelve a la versión anterior.
MM_ENABLED=true
MM_STRATEGY=v2
MM_MAX_LOSS_USD=2000
MM_MAX_TOTAL_LOSS_USD=50000

# Protección contra apostadores informados. TOX_ENABLED=false la apaga.
TOX_ENABLED=true
TOX_MAX_SURCHARGE_BPS=300
TOX_IMBALANCE_SPREAD=0.12

# Resolución con fianzas (docs/ORACULO.md)
RESOLUTION_BOND_USD=10
HOUSE_BOND_USD=100

# P2P (docs/P2P.md)
MAKER_REBATE_BPS=50

# Límite por jugador y mercado
MAX_STAKE_PER_MARKET_USD=1000

# Mínimo de mercados por categoría que la IA mantiene, y si publica sin moderación
MIN_OPEN_PER_CATEGORY=25
AUTO_APPROVE_AI_DRAFTS=false

# Tesorería (docs/TESORERIA.md)
SETTLEMENT_EVERY_HOURS=24
SETTLEMENT_PAYMENT_TERM_HOURS=48
TREASURY_AUTO_COLLECT_GUARANTEE=false

# Sello diario del libro en Bitcoin (OpenTimestamps, gratis)
ANCHOR_ENABLED=true
# Vía USDC (opcional; se activa con las tres primeras). La plataforma solo lee la cadena.
# Mientras están en pruebas, elige UNA de estas dos y deja comentado el bloque real de abajo:
#   a) Simulado, sin cadena (las transferencias se simulan en Tesorería):
# USDC_CHAIN=simulado
#   b) Red de prueba Base Sepolia (USDC gratis en faucet.circle.com, bóveda Safe en Base Sepolia):
# USDC_CHAIN=base-sepolia
# USDC_RPC_URL=https://sepolia.base.org
# USDC_VAULT_ADDRESS=0x<Safe en Base Sepolia>
# USDC_CONFIRMATIONS=2
#   Real (cuando pasen a producción):
# USDC_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/<clave>
# USDC_CHAIN=polygon
# USDC_VAULT_ADDRESS=0x<dirección de la bóveda multifirma>
# USDC_START_BLOCK=<bloque en que se creó la bóveda>

# Solo si despliegas el casino de prueba (servicio "casino")
# DEMO_CASINO_URL=http://predicciones_casino:4000
